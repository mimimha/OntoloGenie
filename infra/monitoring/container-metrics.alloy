// Linux 서버 전용. CPU·메모리만 수집해 디스크 용량 스캔 등의 부하를 줄인다.
prometheus.exporter.cadvisor "docker" {
  docker_host               = "unix:///var/run/docker.sock"
  containerd_host           = "/run/containerd/containerd.sock"
  containerd_namespace      = "moby"
  docker_only               = true
  disable_root_cgroup_stats = true
  enabled_metrics           = ["cpu", "memory"]
  storage_duration          = "1m"
  store_container_labels    = false
  allowlisted_container_labels = ["com.docker.compose.service", "com.docker.compose.project"]
}

discovery.relabel "containers" {
  targets = prometheus.exporter.cadvisor.docker.targets

  rule {
    target_label = "instance"
    replacement  = sys.env("HOST_METRICS_INSTANCE")
  }

  rule {
    target_label = "job"
    replacement  = "cadvisor"
  }
}

prometheus.scrape "containers" {
  targets         = discovery.relabel.containers.output
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.remote_write.local.receiver]
}
