# 서버 ~/axcore/.env 에 실제 값을 넣는다. 이 파일은 변수 이름만 기록한다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 배포할 backend 이미지 태그 (= 커밋 SHA 7자리). 5-7부터 Jenkins가 갱신
BACKEND_TAG=
# 배포할 frontend 이미지 태그 (= 커밋 SHA 7자리). 첫 배포는 손으로 넣고, 5-7 확장 뒤 Jenkins가 갱신
FRONTEND_TAG=
# 첫 관리자 계정 (관리자가 없을 때 한 번만 사용). 값은 서버 .env에만 둔다
AXCORE_INITIAL_ADMIN_LOGIN_ID=
AXCORE_INITIAL_ADMIN_PASSWORD=
