{
  "tables": {
    "lims_spec": {
      "description": "제품별 시험 기준(규격)",
      "primary_key": [
        "spec_id"
      ],
      "columns": {
        "spec_id": {
          "type": "integer",
          "comment": "규격 ID"
        },
        "product_code": {
          "type": "varchar(12)",
          "comment": "대상 제품"
        },
        "test_item": {
          "type": "varchar(30)",
          "comment": "시험 항목"
        },
        "method": {
          "type": "varchar(40)",
          "comment": "시험 방법"
        },
        "lower_limit": {
          "type": "numeric(10,2)",
          "comment": "하한"
        },
        "upper_limit": {
          "type": "numeric(10,2)",
          "comment": "상한"
        },
        "unit": {
          "type": "varchar(10)",
          "comment": ""
        },
        "version": {
          "type": "varchar(5)",
          "comment": "규격 개정"
        },
        "eff_date": {
          "type": "date",
          "comment": ""
        }
      }
    },
    "lims_sample": {
      "description": "시험 검체 접수",
      "primary_key": [
        "sample_id"
      ],
      "columns": {
        "sample_id": {
          "type": "varchar(15)",
          "comment": "검체 번호"
        },
        "sample_type": {
          "type": "varchar(10)",
          "comment": "검체 구분"
        },
        "lot_no": {
          "type": "varchar(12)",
          "comment": "제조 로트"
        },
        "supplier_lot": {
          "type": "varchar(12)",
          "comment": "원료 공급사 로트"
        },
        "requester_no": {
          "type": "varchar(6)",
          "comment": "의뢰 고객 번호"
        },
        "received_at": {
          "type": "timestamp",
          "comment": "접수 일시"
        },
        "box_no": {
          "type": "integer",
          "comment": "보관함 번호"
        },
        "status": {
          "type": "varchar(6)",
          "comment": ""
        }
      }
    },
    "lims_test_result": {
      "description": "시험 결과",
      "primary_key": [
        "result_id"
      ],
      "columns": {
        "result_id": {
          "type": "varchar(10)",
          "comment": "결과 ID"
        },
        "sample_id": {
          "type": "varchar(15)",
          "comment": "검체 번호"
        },
        "spec_id": {
          "type": "integer",
          "comment": "적용 규격"
        },
        "result_value": {
          "type": "varchar(20)",
          "comment": "측정값"
        },
        "judgement": {
          "type": "varchar(5)",
          "comment": "판정"
        },
        "analyst": {
          "type": "varchar(6)",
          "comment": ""
        },
        "tested_at": {
          "type": "date",
          "comment": "시험일"
        }
      }
    }
  }
}